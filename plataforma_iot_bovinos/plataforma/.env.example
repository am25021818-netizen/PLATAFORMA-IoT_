# Variables de entorno para despliegue en servidor o Docker
# Copiar este archivo como .env y modificar según sea necesario

MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
DB_PATH=/app/data/datos_iot.db

# Umbrales de vigencia (en segundos)
UMBRAL_RETRASO_SEG=600        # 10 minutos
UMBRAL_DESCONEXION_SEG=1800   # 30 minutos
